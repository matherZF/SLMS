# ============================================================
# 本地开发配置模板（可提交到仓库）
# 用法：
#   1. 复制本文件为同目录下的 application-local.yml
#   2. 把 <...> 占位替换成真实值
#   3. IDEA 运行配置：Active profiles = local，Working directory = backend
# ============================================================
spring:
  datasource:
    url: jdbc:mysql://127.0.0.1:3306/spare_parts?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
    username: root
    password: <本机 MySQL 密码>
  jpa:
    hibernate:
      ddl-auto: validate
  flyway:
    enabled: true
  sql:
    init:
      mode: never

jwt:
  # 至少 32 字节，随便换一个只有本地在用的字符串即可
  secret: <本地开发用随机密钥，openssl rand -base64 48>

eslabel:
  enabled: false

ext-stat:
  enabled: false
